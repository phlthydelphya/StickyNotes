<component type="desktop-application">
  <id>io.github.phlthydelphya.StickyNotes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Sticky Gnotes</name>
  <summary>Quick colored notes on your desktop</summary>
  <developer id="io.github.phlthydelphya">
    <name>phlthydelphya</name>
  </developer>
  <description>
    <p>
      Sticky Gnotes keeps quick colored notes in a searchable list. Any note can pop out
      into its own small window on the desktop.
    </p>
    <ul>
      <li>Bold, italic, underline and strikethrough text, images and links</li>
      <li>Bullet, numbered and check lists</li>
      <li>Seven note colors, with light and dark palettes</li>
      <li>Reminders that pop the note out with a notification</li>
      <li>Screenshots straight into a note, and search that finds the text in images</li>
      <li>Notes in the GNOME Activities search</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.phlthydelphya.StickyNotes.desktop</launchable>
  <provides>
    <binary>dusk-sticky-notes</binary>
    <dbus type="user">io.github.phlthydelphya.StickyNotes</dbus>
  </provides>
  <screenshots>
    <screenshot type="default" environment="gnome">
      <caption>The notes list, with a pinned checklist and a reminder</caption>
      <image type="source" width="507" height="600">https://raw.githubusercontent.com/phlthydelphya/StickyNotes/v1.0.1/data/screenshots/notes-list.png</image>
    </screenshot>
    <screenshot environment="gnome">
      <caption>A note popped out on the desktop</caption>
      <image type="source" width="360" height="300">https://raw.githubusercontent.com/phlthydelphya/StickyNotes/v1.0.1/data/screenshots/note.png</image>
    </screenshot>
    <screenshot environment="gnome:dark">
      <caption>The notes list in the dark style</caption>
      <image type="source" width="507" height="600">https://raw.githubusercontent.com/phlthydelphya/StickyNotes/v1.0.1/data/screenshots/notes-list-dark.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/phlthydelphya/StickyNotes</url>
  <url type="bugtracker">https://github.com/phlthydelphya/StickyNotes/issues</url>
  <url type="vcs-browser">https://github.com/phlthydelphya/StickyNotes</url>
  <branding>
    <color type="primary" scheme_preference="light">#fff2ab</color>
    <color type="primary" scheme_preference="dark">#544d2a</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.1" date="2026-11-17">
      <description>
        <p>The app ID is now io.github.phlthydelphya.StickyNotes. A start-at-login entry
        from 1.0.0 moves to the new name by itself; notes and settings stay where they are.</p>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-17">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
